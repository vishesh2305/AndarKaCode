{
  "name": "builder-api",
  "version": "0.1.0",
  "private": true,
  "description": "Laptop A: orchestrator (projects, Contracts, jobs, Sync Barrier)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "eval:inventory": "node --env-file-if-exists=.env scripts/eval-inventory.mjs",
    "smoke:wire": "node scripts/wire-smoke.mjs",
    "eval:pages": "node --env-file-if-exists=.env scripts/eval-pages.mjs",
    "eval:custom":"node --env-file-if-exists=.env scripts/custom-model-test.mjs",
    "test:integration": "node --test --test-concurrency=1 \"integration/**/*.test.js\""
  },
  "dependencies": {
    "acorn": "8.18.0",
    "express": "^5.3.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "jsdom": "29.1.1"
  }
}
