# Laptop A only. Copy to builder-api/.env and fill in.
PORT=4000
# localhost only until GitHub login exists (Step 15).
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/builder_db
# local = free GPU/Mac models, cloud = Gemini (free tier: 20 requests/day), auto = local then cloud.
DEFAULT_MODE=local

# Gateway on Laptop B: its Tailscale IP (run `tailscale ip -4` on Laptop B).
GATEWAY_URL=http://100.x.y.z:8787
# Must match GATEWAY_API_KEY in gateway/.env.
GATEWAY_API_KEY=

# Contract Extractor
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
GEMINI_API_KEY=
# gemini-2.5-flash is closed to new users (404, 1 Nov 2026); gemini-3.8-flash did not answer in 90 s that day.
GEMINI_MODEL=gemini-3.5-flash

# Coding AI for buttons no template covers (Step 13); it follows each project's mode.
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
# Without this line, the cloud coding model is GEMINI_MODEL. gemini-3.5-flash got 5/5 in our test.
# GEMINI_CODE_MODEL=gemini-3.5-flash

# Step 20: every setting above is checked at start; a wrong one stops the start with every problem listed.
# Logs: text (default) or json (one JSON object per line, for production log collectors).
# LOG_FORMAT=json
# How many at once: screenshots read (1-20, default 6), custom buttons written (1-20, default 3).
# READ_PARALLEL=6
# CUSTOM_PARALLEL=3
