# Laptop A only. Copy to builder-api/.env and fill in.
PORT=4000
# localhost only unless sign-in is on (AUTH=on, Step 29, below).
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/builder_db
# local = free GPU/Mac models, cloud = Gemini (free tier: 20 requests/day), auto = local then cloud.
DEFAULT_MODE=local

# Gateway on Laptop B: its Tailscale IP (run `tailscale ip -4` on Laptop B).
GATEWAY_URL=http://100.x.y.z:8787
# Must match GATEWAY_API_KEY in gateway/.env.
GATEWAY_API_KEY=

# Contract Extractor
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
GEMINI_API_KEY=
# gemini-2.5-flash is closed to new users (404, 1 Nov 2026); gemini-3.8-flash did not answer in 90 s that day.
GEMINI_MODEL=gemini-3.5-flash

# Coding AI for buttons no template covers (Step 13); it follows each project's mode.
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
# Without this line, the cloud coding model is GEMINI_MODEL. gemini-3.5-flash got 5/5 in our test.
# GEMINI_CODE_MODEL=gemini-3.5-flash

# Step 20: every setting above is checked at start; a wrong one stops the start with every problem listed.
# Logs: text (default) or json (one JSON object per line, for production log collectors).
# LOG_FORMAT=json
# How many at once: screenshots read (1-20, default 6), custom buttons written (1-20, default 3).
# READ_PARALLEL=6
# CUSTOM_PARALLEL=3

# Step 29: sign-in. off (default) = this computer only, no accounts. on = GitHub and/or Google sign-in,
# invited accounts only (add them with: npm run invite -- add someone@example.com).
# AUTH=on
# The address people open; each provider's OAuth app must allow <PUBLIC_URL>/auth/<github|google>/callback.
# PUBLIC_URL=http://127.0.0.1:4000
# GitHub: Settings > Developer settings > OAuth Apps. Google: Cloud Console > APIs & Services > Credentials.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# How long a sign-in lasts (1-90 days, default 14).
# SESSION_DAYS=14

# Step 31: people's own AI keys (BYOK, needs AUTH=on). The secret their keys are encrypted with: 64 hex
# characters, made once with `openssl rand -hex 32`, never committed, and the same on every service that
# builds (api, orchestrator, ui-worker). Losing it makes every saved key unreadable (people add them again).
# KEY_VAULT_SECRET=
