# Laptop B only. Copy to gateway/.env and fill in.
PORT=8787
# Listen only on Laptop B's Tailscale address (`tailscale ip -4`), never on the Wi-Fi.
# Use 127.0.0.1 to test on this laptop alone.
HOST=127.0.0.1

# Shared secret. Laptop A sends it in the X-API-Key header.
# Must match GATEWAY_API_KEY in builder-api/.env.
GATEWAY_API_KEY=

# Screenshot-to-Code and Ollama stay on localhost; only the Gateway is reachable from Laptop A.
# 7002, not S2C's default 7001: NoMachine takes 7001 on Laptop B. scripts\start-laptop-b.ps1 starts S2C on this port.
S2C_WS_URL=ws://127.0.0.1:7002/generate-code
OLLAMA_URL=http://127.0.0.1:11434

# Cloud backup for mode=cloud. Leave empty to disable cloud mode.
GEMINI_API_KEY=

# Step 23b: who draws the pages. single = one model call per page (default, decided in Step 18.6);
# s2c = Screenshot-to-Code (then S2C must be running on S2C_WS_URL).
PAGE_BUILDER=single
# Pages drawn at the same time: the local GPU one at a time, the cloud model several.
LOCAL_PARALLEL=1
CLOUD_PARALLEL=4
