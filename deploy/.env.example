# Settings for docker compose (copy to deploy/.env; deploy/.env is git-ignored).
# Which server this machine is (Step 28): server-1, server-2, or both on one machine.
COMPOSE_PROFILES=server-1,server-2
# Server 2 only: where server 1's MongoDB is (its private address). Empty on server 1 or one machine.
MONGODB_URI=
# Server 1 with a separate server 2: server 1's private address (Tailscale or the private network),
# never a public one (no database login yet). 127.0.0.1 keeps MongoDB on this machine.
MONGO_BIND=127.0.0.1
MONGO_PORT=27018
# Laptop B's Gateway over Tailscale (both or neither):
GATEWAY_URL=
GATEWAY_API_KEY=
# Ollama on this computer, seen from inside the containers:
OLLAMA_URL=http://host.docker.internal:11434
GEMINI_API_KEY=
DEFAULT_MODE=local
# Where pages are drawn: empty = Laptop B's Gateway when GATEWAY_URL is set, else the ui-worker (queue).
PAGE_LANE=
UI_PARALLEL=4
# A ui-worker warns when its round trip to MongoDB is over this many ms (servers too far apart):
PLACEMENT_MS=5
