# Settings for docker compose (copy to deploy/.env; deploy/.env is git-ignored).
# Laptop B's Gateway over Tailscale (both or neither):
GATEWAY_URL=
GATEWAY_API_KEY=
# Ollama on this computer, seen from inside the containers:
OLLAMA_URL=http://host.docker.internal:11434
GEMINI_API_KEY=
DEFAULT_MODE=local
# Where pages are drawn: empty = Laptop B's Gateway when GATEWAY_URL is set, else the ui-worker (queue).
PAGE_LANE=
UI_PARALLEL=4
